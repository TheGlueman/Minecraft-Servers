# This folder is mostly world data, backups and jars (tens of GB), so git ignores
# everything by default and only the small hand-edited text files below are tracked.
/*
!/.gitignore
!/README.md
!/scripts/
!/docker/
!/docker.sh
# Each Docker server's files live in docker/<name>/server/. Track the same small files as
# for the run.sh servers, except server.properties: Docker writes the RCON password into it.
/docker/*/server/*
!/docker/*/server/config/
!/docker/*/server/mods.txt
!/docker/*/server/eula.txt
!/docker/*/server/whitelist.json
!/docker/*/server/ops.json

# Never commit generated files anywhere, even inside allowed folders
# (some mods, e.g. CustomSpawner, write logs into config/).
__pycache__/
*.pyc
*.log
*.lock
*.zip
*.7z

# --- legacy/: the old run.sh setup (scripts and the two original server folders) ---
!/legacy/
/legacy/*
!/legacy/README.md
!/legacy/scripts/

# --- legacy/Emily-Server (Fabric 26.3) ---
!/legacy/Emily-Server/
/legacy/Emily-Server/*
!/legacy/Emily-Server/server.conf
!/legacy/Emily-Server/server.properties
!/legacy/Emily-Server/config/
!/legacy/Emily-Server/mods.txt
!/legacy/Emily-Server/eula.txt
!/legacy/Emily-Server/whitelist.json
!/legacy/Emily-Server/ops.json

# --- legacy/HBM-Space-Server-3 (Forge 1.7.10) ---
!/legacy/HBM-Space-Server-3/
/legacy/HBM-Space-Server-3/*
!/legacy/HBM-Space-Server-3/server.conf
!/legacy/HBM-Space-Server-3/server.properties
!/legacy/HBM-Space-Server-3/config/
!/legacy/HBM-Space-Server-3/mods.txt
!/legacy/HBM-Space-Server-3/eula.txt
!/legacy/HBM-Space-Server-3/whitelist.json
!/legacy/HBM-Space-Server-3/ops.json
# Older per-server scripts, kept for reference (mod sync tool for HBM).
!/legacy/HBM-Space-Server-3/server-scripts/

# New servers go in docker/<name>/ (see docker/server.conf.example), which is already allowed.
